# ── 비밀 (절대 커밋 금지) ─────────────────────────────────────────────
control/notify.conf

# ── 런타임 상태 (템플릿 내용이 아니다) ────────────────────────────────
# 락과 우편함은 "지금 누가 무엇을 하는가"라는 휘발성 상태다.
# 팀에서 공유하고 싶다면(여러 사람이 같은 트리를 쓸 때) 아래 두 줄을 빼도 된다 —
# 다만 그러면 커밋 충돌이 잦아진다.
control/locks/
control/inbox/
control/logs/
control/runs/

# ── 파이썬 ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── OS/편집기 ────────────────────────────────────────────────────────
.DS_Store
*.swp
